# Gemini is the only LLM provider; change LLM_MODEL to select a model manually.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=replace_with_your_gemini_api_key
LLM_RETRY_CONTENT_VALIDATION=0

#gemini-3.8-flash (top priority)
#gemini-3.6-flash (if 3.8 did not work duo to high workload, choose this one)
#gemini-3.5-flash-lite (if 3.6 did not work duo to high workload choose this one . I used this one most of the time because the rest were not always available.)

# Optional:
# LLM_THINKING_LEVEL=medium
# LLM_MAX_OUTPUT_TOKENS=6000