# Google Gemini Configuration
# Model selection is manual; restart the backend after changing LLM_MODEL.

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Response Validation
# 0 = Reject invalid JSON/schema responses without retrying.
# 1 = Allow one additional generation attempt if validation fails.
# This setting does not retry API errors or perform factual verification.

LLM_RETRY_CONTENT_VALIDATION=0

# Alternative Gemini Models
# If the primary model is unavailable, manually update LLM_MODEL
# to an alternative supported by your API key.
# Availability and usage limits may vary.

# gemini-3.8-flash       (preferred)
# gemini-3.6-flash       (alternative)
# gemini-3.5-flash-lite  (lightweight alternative)

